<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="轻笺" Width="580" Height="430" MinWidth="500" MinHeight="340" Background="{DynamicResource WorkSurface}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="WorkSurface" Color="#F7F8FA"/>
  <SolidColorBrush x:Key="PaperSurface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#25303D"/>
  <SolidColorBrush x:Key="SecondaryInk" Color="#4D5A6A"/>
  <SolidColorBrush x:Key="Muted" Color="#657181"/>
  <SolidColorBrush x:Key="DisabledInk" Color="#87909C"/>
  <SolidColorBrush x:Key="Accent" Color="#285BE2"/>
  <SolidColorBrush x:Key="SelectedSurface" Color="#E9EFFC"/>
  <SolidColorBrush x:Key="HoverSurface" Color="#EBEDF1"/>
  <SolidColorBrush x:Key="PressedSurface" Color="#DDE4F0"/>
  <SolidColorBrush x:Key="Divider" Color="#E4E7EC"/>
  <SolidColorBrush x:Key="ErrorInk" Color="#B42332"/>
  <SolidColorBrush x:Key="MemoYellow" Color="#FFD66B"/>
  <SolidColorBrush x:Key="MemoBlue" Color="#A4C9FA"/>
  <SolidColorBrush x:Key="MemoGreen" Color="#A7D9BD"/>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="28"/><Setter Property="MinWidth" Value="28"/><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverSurface}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PressedSurface}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionBrush" Value="#B9D1FF"/></Style>
  <Style TargetType="ToolTip"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Row="0" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,1" Padding="12,0,6,0">
   <DockPanel LastChildFill="False">
    <Button x:Name="NewButton" DockPanel.Dock="Right" Width="28" Height="28" VerticalAlignment="Center" ToolTip="新建便笺 · Ctrl+N" AutomationProperties.Name="新建便笺"><Path Data="M7,1 L7,13 M1,7 L13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/></Button>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="便笺" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="NoteTotal" Margin="6,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="8,0,6,0">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PinButton" Margin="2,0,0,0" ToolTip="浮在其他窗口上方 · Ctrl+T" AutomationProperties.Name="切换置顶"><StackPanel Orientation="Horizontal"><Path Data="M4,1 L12,1 M5,1 L5,6 L2,9 L2,10 L14,10 L14,9 L11,6 L11,1 M8,10 L8,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="13" Height="14" Stretch="Uniform"/><TextBlock x:Name="PinText" Text="置顶" Margin="5,0,0,0"/></StackPanel></Button>
     <Button x:Name="MoreButton" Width="28" Margin="2,0,0,0" ToolTip="设置与更多" AutomationProperties.Name="设置与更多"><Path Data="M2,7 A0.8,0.8 0 1 0 3.6,7 A0.8,0.8 0 1 0 2,7 M7,7 A0.8,0.8 0 1 0 8.6,7 A0.8,0.8 0 1 0 7,7 M12,7 A0.8,0.8 0 1 0 13.6,7 A0.8,0.8 0 1 0 12,7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/></Button>
    </StackPanel>
    <Button x:Name="ReminderButton" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" MaxWidth="210" ToolTip="选择提醒日期与时间" AutomationProperties.Name="设置日期提醒">
     <StackPanel Orientation="Horizontal"><Path Data="M2,3 L14,3 L14,14 L2,14 Z M5,1 L5,5 M11,1 L11,5 M2,7 L14,7 M5,10 L7,10 M9,10 L11,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="14" Height="14" Stretch="Uniform"/><TextBlock x:Name="ReminderText" Text="设置提醒" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Button>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0" Padding="4,4,4,0">
   <ListBox x:Name="NotesList" AutomationProperties.Name="便笺导航列表" ToolTip="点击切换 · 右键删除 · Ctrl+L 聚焦列表" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"><Grid><Border x:Name="IndexMark" Background="Transparent" Width="2" HorizontalAlignment="Left" Margin="0,8"/><ContentPresenter Margin="{TemplateBinding Padding}"/></Grid></Border><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource HoverSurface}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedSurface}"/><Setter TargetName="IndexMark" Property="Background" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
   </ListBox>
  </Border>
  <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource PaperSurface}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Margin="16,0,16,0" Padding="0,14,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="ColorStrip" Background="{StaticResource MemoYellow}" Width="3" Height="18" VerticalAlignment="Center" CornerRadius="1"/>
     <TextBox x:Name="TitleBox" Grid.Column="2" AutomationProperties.Name="便笺标题" MaxLength="120" FontSize="18" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center" ToolTip="便笺标题"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="16,12,12,12">
    <TextBlock Text="写下要记住的事…" Foreground="{StaticResource DisabledInk}" FontSize="14" Margin="1,2,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=BodyBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBox x:Name="BodyBox" AutomationProperties.Name="便笺正文" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="14" Padding="0,1" SpellCheck.IsEnabled="False"/>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="12,0">
   <DockPanel LastChildFill="True" VerticalAlignment="Center">
    <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
    <TextBlock x:Name="SaveText" Text="自动保存" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="便笺自动保存在本机。关闭窗口后仍在托盘运行。"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
